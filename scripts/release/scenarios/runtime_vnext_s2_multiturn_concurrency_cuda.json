{
  "backend": "cuda",
  "ferrum_bin": "target/release/ferrum",
  "goal_scope": {
    "full_s2": false,
    "multiturn_concurrency_sentinel": true
  },
  "model": "Qwen/Qwen3.5-4B",
  "observability": {
    "enabled": true,
    "profile_detail": "basic",
    "profile_sample_rate": 1.0
  },
  "schema_version": 1,
  "server": {
    "args": [
      "--backend",
      "cuda",
      "--max-num-seqs",
      "2"
    ],
    "mode": "start"
  },
  "timeout_sec": 600,
  "scenarios": [
    {
      "name": "m1_s2_run_multiturn_recall",
      "type": "run_multiturn",
      "backend": "cuda",
      "enable_thinking": false,
      "secret": "banana",
      "expected_recall": "banana",
      "historical_case_ids": [
        "H02.1"
      ],
      "min_assistant_turns": 5,
      "use_default_max_tokens": true,
      "temperature": 0.0,
      "prompts": [
        "Remember the codeword banana. Reply exactly OK.",
        "Reply with only TWO.",
        "Reply with only THREE.",
        "Reply with only FOUR.",
        "What codeword did I ask you to remember? Answer with only the codeword."
      ]
    },
    {
      "name": "m1_s2_serve_multiturn_recall",
      "type": "serve_multiturn_recall",
      "secret": "banana",
      "first_prompt": "Remember the codeword banana. Reply exactly OK.",
      "second_prompt": "What codeword did I ask you to remember? Answer with only the codeword.",
      "enable_thinking": false,
      "max_tokens": 128,
      "temperature": 0.0
    },
    {
      "name": "m1_s2_serve_concurrency_quality",
      "type": "serve_concurrency_quality",
      "enable_thinking": false,
      "concurrency_cells": [
        1,
        4
      ]
    }
  ]
}
