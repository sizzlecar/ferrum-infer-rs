{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-envelope-v1.schema.json",
  "title": "Ferrum vNext model-adoption receipt envelope v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/git_sha"
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "git_sha",
        "dirty",
        "dirty_status"
      ],
      "properties": {
        "git_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "dirty": {
          "type": "boolean"
        },
        "dirty_status": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": [
        "started_at",
        "finished_at",
        "duration_seconds",
        "expected_duration_seconds",
        "hard_deadline_at",
        "progress_signal"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "expected_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hard_deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "progress_signal": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "artifact_reference": {
      "type": "object",
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "stage_result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_type",
        "checkpoint",
        "candidate",
        "sanitized_environment",
        "argv",
        "timing",
        "references"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "sanitized_environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timing": {
          "$ref": "#/$defs/timing"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_reference"
          }
        }
      }
    }
  }
}
