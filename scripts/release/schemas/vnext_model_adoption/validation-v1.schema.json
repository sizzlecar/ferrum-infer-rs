{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation-v1.schema.json",
  "title": "Ferrum vNext model-adoption validation receipt v1",
  "allOf": [
    {
      "$ref": "common-envelope-v1.schema.json#/$defs/envelope"
    },
    {
      "type": "object",
      "required": [
        "binary_sha256",
        "milestones",
        "fail_closed",
        "local_path",
        "numeric_approval",
        "architecture_audit"
      ],
      "properties": {
        "artifact_type": {
          "const": "validation"
        },
        "binary_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "milestones": {
          "type": "object",
          "required": [
            "M1",
            "M2",
            "M3",
            "M6"
          ],
          "properties": {
            "M1": {
              "$ref": "common-envelope-v1.schema.json#/$defs/stage_result"
            },
            "M2": {
              "$ref": "common-envelope-v1.schema.json#/$defs/stage_result"
            },
            "M3": {
              "$ref": "common-envelope-v1.schema.json#/$defs/stage_result"
            },
            "M6": {
              "$ref": "common-envelope-v1.schema.json#/$defs/stage_result"
            }
          },
          "additionalProperties": false
        },
        "fail_closed": {
          "type": [
            "object",
            "null"
          ]
        },
        "local_path": {
          "type": [
            "object",
            "null"
          ]
        },
        "numeric_approval": {
          "type": [
            "object",
            "null"
          ]
        },
        "architecture_audit": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  ]
}
