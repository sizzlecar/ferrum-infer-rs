# Source bytes are embedded by include_str! contracts and provider fingerprints.
*.rs text eol=lf

# Preserve upstream chat-template bytes and exact rendered-prompt goldens.
/crates/ferrum-server/tests/fixtures/chat_template/**/template.jinja text eol=lf
/crates/ferrum-server/tests/fixtures/chat_template/**/golden_*.txt text eol=lf

# Native package inputs with canonical JSON byte contracts.
/native-operators/abi/ferrum-native-abi-v2.json text eol=lf
/native-operators/cuda/package-definitions/*.json text eol=lf
# Preserve the qualified FastVideo header bytes bound by the native source lock.
crates/ferrum-kernels/native/sage-vsa-fp4/params.h text eol=lf whitespace=-blank-at-eol
crates/ferrum-kernels/native/sage-vsa-fp4/quantize_core.cuh text eol=lf whitespace=-blank-at-eol
